ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=BMBAssessment;Persist Security Info=False;User ID=your-user;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
Jwt__Issuer=BMBAssessment.API
Jwt__Audience=BMBAssessment.Client
Jwt__Key=replace-with-a-random-secret-at-least-32-characters
Jwt__ExpiryMinutes=60
# Add the browser origin only when the frontend is hosted separately.
Frontend__Origins__0=https://your-frontend-host.example.com
